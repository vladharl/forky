# Copy to .env or paste into your shell rc (~/.zshrc).
# Required:
EXEC_BASE_URL="https://your-openai-compatible-endpoint.example.com/v1"
EXEC_API_KEY="your-api-key-here"

# Optional:
EXEC_MODEL="qwen-35b"          # model name your backend recognizes
PORT="3456"                    # forky listening port
# FORKY_FIRST_BYTE_MS=30000
# FORKY_INTER_CHUNK_MS=15000
# FORKY_CIRCUIT_THRESHOLD=3
